{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/246mayank/convo-insights/contracts/segment-track.schema.json",
  "title": "Conversation Analyzed (Segment Track call on insights.segment)",
  "type": "object",
  "required": ["type", "event", "messageId", "timestamp", "properties"],
  "oneOf": [
    { "required": ["userId"] },
    { "required": ["anonymousId"] }
  ],
  "properties": {
    "type": { "const": "track" },
    "event": { "const": "Conversation Analyzed" },
    "userId": { "type": "string", "description": "customerId: hashed address (Twilio) or anonymised author id (TWCS)" },
    "anonymousId": { "type": "string", "description": "conversationId, when no customer is known" },
    "messageId": { "type": "string", "description": "eventId; Segment dedupes on it" },
    "timestamp": { "type": "string", "format": "date-time", "description": "when the conversation started (event time)" },
    "properties": {
      "type": "object",
      "required": ["conversation_id", "intent", "sentiment", "summary", "confidence", "extractor", "pii_redactions"],
      "properties": {
        "conversation_id": { "type": "string" },
        "brand": { "type": ["string", "null"] },
        "channel": { "type": ["string", "null"], "enum": ["twitter", "sms", "whatsapp", "chat", null] },
        "intent": { "type": "string" },
        "sentiment": { "enum": ["POSITIVE", "NEUTRAL", "NEGATIVE"] },
        "summary": { "type": "string", "maxLength": 500 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "extractor": { "enum": ["LLM", "RULES"] },
        "model": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] },
        "pii_redactions": { "type": "integer", "minimum": 0 }
      }
    },
    "context": { "type": "object" }
  }
}
