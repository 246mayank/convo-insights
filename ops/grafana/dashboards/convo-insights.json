        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(insights_llm_latency_seconds_bucket[2m])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
